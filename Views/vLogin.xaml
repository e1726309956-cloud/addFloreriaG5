<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="addFloreriaG5.Views.vLogin"
             Title="Iniciar Sesión"
    BackgroundColor="#F9F6F0">

    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="20"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            MaximumWidthRequest="450">

            <Image
                Source="logo.png"
                HeightRequest="130"
                WidthRequest="130"
                HorizontalOptions="Center"
                Margin="0,10,0,0"/>

            <Label
                Text="FLORERÍA APP"
                FontSize="26"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                TextColor="#707A5E"/>

            <Label
                Text="Bienvenido de nuevo, inicia sesión para continuar"
                FontSize="14"
                HorizontalOptions="Center"
                TextColor="#8C857B"
                Margin="0,0,0,10"/>

            <Frame BackgroundColor="White" 
                   BorderColor="#E0DCD5" 
                   CornerRadius="14" 
                   Padding="15" 
                   HasShadow="True">

                <VerticalStackLayout Spacing="12">
                    <!-- Campo de Correo -->

                    <Entry
                x:Name="txtCorreo"
                Placeholder="Correo electrónico"
                PlaceholderColor="#B0A8A0"
                        TextColor="#4A453F"
                        Keyboard="Email"
                        FontSize="15"
                        BackgroundColor="Transparent"/>

                    <BoxView HeightRequest="1" Color="#EFECE6" Margin="0,2"/>

                    <Entry
                x:Name="txtPassword"
Placeholder="Contraseña"
                        PlaceholderColor="#B0A8A0"
                        TextColor="#4A453F"
                        IsPassword="True"
                        FontSize="15"
                        BackgroundColor="Transparent"/>

                </VerticalStackLayout>
            </Frame>

            <Button
                Text="Ingresar"
                Clicked="Button_Clicked_1"
                BackgroundColor="#707A5E"
                TextColor="White"
                FontAttributes="Bold"
                FontSize="16"
                CornerRadius="12"
                HeightRequest="50"
                Margin="0,5,0,0"/>

            <Button
                Text="Crear una cuenta nueva"
                Clicked="Button_Clicked_2"
                BackgroundColor="Transparent"
                TextColor="#D39E82"
                BorderColor="#D39E82"
                BorderWidth="1.5"
                FontAttributes="Bold"
                FontSize="14"
                CornerRadius="12"
                HeightRequest="45"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>