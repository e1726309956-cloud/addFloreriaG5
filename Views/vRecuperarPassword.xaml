<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="addFloreriaG5.Views.vRecuperarPassword" Title="Recuperar contraseña" BackgroundColor="#FFF9F6">
    <ContentPage.Resources>
        <Style TargetType="Entry"><Setter Property="TextColor" Value="#35232A" /><Setter Property="PlaceholderColor" Value="#765B63" /><Setter Property="BackgroundColor" Value="Transparent" /><Setter Property="HeightRequest" Value="50" /></Style>
        <Style TargetType="Button"><Setter Property="BackgroundColor" Value="#812A44" /><Setter Property="TextColor" Value="White" /><Setter Property="CornerRadius" Value="12" /><Setter Property="HeightRequest" Value="50" /></Style>
        <Style TargetType="Border"><Setter Property="BackgroundColor" Value="White" /><Setter Property="Stroke" Value="#9B6574" /><Setter Property="StrokeThickness" Value="1.5" /><Setter Property="StrokeShape" Value="RoundRectangle 10" /><Setter Property="Padding" Value="12,0" /></Style>
    </ContentPage.Resources>
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16" MaximumWidthRequest="450">
            <Label Text="Recuperar contraseña" FontSize="24" FontAttributes="Bold" TextColor="#7D273E" />
            <Label Text="Solicita un código y consulta tu correo desde cualquier dispositivo." TextColor="#35232A" />
            <Border><Entry x:Name="correo" Placeholder="Correo electrónico" Keyboard="Email" /></Border>
            <Button x:Name="enviar" Text="Enviar código" Clicked="Enviar_Clicked" />
            <Label Text="Código de verificación (8 dígitos)" TextColor="#35232A" />
            <Grid x:Name="contenedorCodigo" />
            <Button x:Name="verificar" Text="Verificar código" IsEnabled="False" Clicked="Verificar_Clicked" />
            <Border><Entry x:Name="clave" Placeholder="Nueva contraseña" IsPassword="True" IsEnabled="False" /></Border>
            <Label x:Name="requisitos" FontSize="12" TextColor="#68454D" />
            <Border><Entry x:Name="confirmar" Placeholder="Confirmar contraseña" IsPassword="True" IsEnabled="False" /></Border>
            <Button x:Name="cambiar" Text="Cambiar contraseña" IsEnabled="False" Clicked="Cambiar_Clicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
