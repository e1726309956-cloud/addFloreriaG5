<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="addFloreriaG5.Views.vLogin"
    Title="Iniciar Sesión"
    BackgroundColor="#FFF9F6"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">

    <!-- CONTENEDOR PRINCIPAL -->
    <Grid>

        <!-- IMAGEN DE FONDO FLORAL -->
        <Image
            Source="fondo_login_floral.png"
            Aspect="AspectFill"
            HorizontalOptions="Fill"
            VerticalOptions="Fill"
            InputTransparent="True"/>

        <!-- CONTENIDO DEL LOGIN -->
        <ScrollView
            Orientation="Vertical"
            VerticalScrollBarVisibility="Default"
            VerticalOptions="Fill"
            HorizontalOptions="Fill">

            <VerticalStackLayout
                MaximumWidthRequest="450"
                HorizontalOptions="Center"
                Spacing="0"
                Padding="0,20,0,35">

                <!-- LOGOTIPO -->
                <Image
                    Source="logo_final.png"
                    WidthRequest="230"
                    HeightRequest="175"
                    Aspect="AspectFit"
                    HorizontalOptions="Center"
                    Margin="0,20,0,25"/>

                <!-- TARJETA PRINCIPAL -->
                <Border
                    Margin="24,8,24,20"
                    Padding="22,25"
                    BackgroundColor="#FFFFFF"
                    Stroke="#F1E3E4"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 24">

                    <!-- SOMBRA -->
                    <Border.Shadow>
                        <Shadow
                            Brush="#BC8C82"
                            Offset="0,4"
                            Radius="12"
                            Opacity="0.10"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="12">

                        <!-- CORREO ELECTRÓNICO -->
                        <HorizontalStackLayout
                            Spacing="9"
                            VerticalOptions="Center">

                            <Image
                                Source="correo.png"
                                WidthRequest="21"
                                HeightRequest="21"/>

                            <Label
                                Text="Correo electrónico"
                                TextColor="#7D273E"
                                FontSize="17"
                                FontAttributes="Bold"
                                VerticalTextAlignment="Center"/>

                        </HorizontalStackLayout>

                        <!-- CAMPO CORREO -->
                        <Border
                            BackgroundColor="#FFF4F6"
                            Stroke="#D7B4BC"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 13"
                            Padding="12,0">

                            <Entry
                                x:Name="txtCorreo"
                                Placeholder="Ingresa tu correo"
                                PlaceholderColor="#A89297"
                                TextColor="#68454D"
                                Keyboard="Email"
                                ClearButtonVisibility="WhileEditing"
                                BackgroundColor="Transparent"
                                FontSize="15"
                                HeightRequest="49"/>

                        </Border>

                        <!-- CONTRASEÑA -->
                        <HorizontalStackLayout
                            Spacing="9"
                            Margin="0,10,0,0"
                            VerticalOptions="Center">

                            <Image
                                Source="candado.png"
                                WidthRequest="21"
                                HeightRequest="21"/>

                            <Label
                                Text="Contraseña"
                                TextColor="#7D273E"
                                FontSize="17"
                                FontAttributes="Bold"
                                VerticalTextAlignment="Center"/>

                        </HorizontalStackLayout>

                        <!-- CAMPO CONTRASEÑA -->
                        <Border
                            BackgroundColor="#FFF4F6"
                            Stroke="#D7B4BC"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 13"
                            Padding="12,0">

                            <Grid ColumnDefinitions="*,40">

                                <Entry
                                    x:Name="txtPassword"
                                    Grid.Column="0"
                                    Placeholder="Ingresa tu contraseña"
                                    PlaceholderColor="#A89297"
                                    TextColor="#68454D"
                                    IsPassword="True"
                                    BackgroundColor="Transparent"
                                    FontSize="15"
                                    HeightRequest="49"/>

                                <!-- MOSTRAR CONTRASEÑA -->
                                <ImageButton
                                    Grid.Column="1"
                                    Source="ojo.png"
                                    BackgroundColor="Transparent"
                                    WidthRequest="32"
                                    HeightRequest="32"
                                    Padding="5"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"
                                    Clicked="TogglePassword_Clicked"
                                    SemanticProperties.Description="Mostrar u ocultar contraseña"/>

                            </Grid>

                        </Border>

                        <Button Text="¿Olvidaste tu contraseña?"
                                Clicked="RecuperarPassword_Clicked"
                                BackgroundColor="Transparent"
                                TextColor="#812A44"
                                HorizontalOptions="End" />

                        <!-- BOTÓN INGRESAR -->
                        <Button
                            Text="Ingresar"
                            Clicked="Ingresar_Clicked"
                            BackgroundColor="#9B3E5C"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="16"
                            CornerRadius="18"
                            HeightRequest="45"
                            WidthRequest="230"
                            HorizontalOptions="Center"
                            Margin="0,0,0,4"/>

                        <!-- BOTÓN REGISTRARSE -->
                        <Button
                            Text="Registrarse"
                            Clicked="btnRegistrarse"
                            BackgroundColor="#FFF6F7"
                            TextColor="#812A44"
                            BorderColor="#A33B59"
                            BorderWidth="1.3"
                            FontAttributes="Bold"
                            FontSize="15"
                            CornerRadius="18"
                            HeightRequest="45"
                            WidthRequest="230"
                            HorizontalOptions="Center"/>

                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>
