<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    x:Class="addFloreriaG5.Views.vRegistroArreglo"
    BackgroundColor="#FFF9F6"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto">

        <!-- FONDO FLORAL -->
        <Image
            Grid.RowSpan="2"
            Source="fondo_login_floral.png"
            Aspect="AspectFill"
            HorizontalOptions="Fill"
            VerticalOptions="Fill"
            InputTransparent="True"/>

        <!-- CONTENIDO DESPLAZABLE -->
        <ScrollView
            Grid.Row="0"
            Orientation="Vertical"
            VerticalScrollBarVisibility="Default">

            <VerticalStackLayout
                Padding="18,22,18,22"
                Spacing="16"
                MaximumWidthRequest="580"
                HorizontalOptions="Center">

                <!-- ENCABEZADO -->
                <Grid
                    ColumnDefinitions="48,*"
                    ColumnSpacing="8"
                    Margin="0,5,0,12">

                    <!-- VOLVER -->
                    <Border
                        Grid.Column="0"
                        BackgroundColor="White"
                        Stroke="#E6D6DA"
                        StrokeShape="RoundRectangle 14"
                        WidthRequest="44"
                        HeightRequest="44"
                        VerticalOptions="Center">

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Tapped="Volver_Clicked"/>
                        </Border.GestureRecognizers>

                        <mi:MauiIcon
                            Icon="{mi:Material Icon=ArrowBack}"
                            IconColor="#752B43"
                            IconSize="24"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"/>

                    </Border>

                    <!-- TÍTULO -->
                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="5">

                        <Label
                            Text="NOVA FLORERÍA"
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="#9B3E5C"
                            CharacterSpacing="2"
                            HorizontalTextAlignment="Center"/>

                        <Label
                            Text="Nuevo arreglo floral"
                            FontSize="24"
                            FontAttributes="Bold"
                            TextColor="#752B43"
                            HorizontalTextAlignment="Center"/>

                    </VerticalStackLayout>
                </Grid>

                <!-- TARJETA DEL FORMULARIO -->
                <Border
                    BackgroundColor="White"
                    Stroke="#E9DCE0"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 24"
                    Padding="20,24">

                    <Border.Shadow>
                        <Shadow
                            Brush="#BCA5AA"
                            Offset="0,3"
                            Radius="10"
                            Opacity="0.10"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="14">

                        <!-- NOMBRE -->
                        <Label
                            Text="Nombre del arreglo"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="#752B43"/>

                        <Border
                            BackgroundColor="#FFF4F6"
                            Stroke="#D7B4BC"
                            StrokeShape="RoundRectangle 12"
                            Padding="12,0">

                            <Entry
                                x:Name="txtNombre"
                                Placeholder="Ingresa el nombre"
                                PlaceholderColor="#A89297"
                                TextColor="#68454D"
                                BackgroundColor="Transparent"
                                HeightRequest="48"
                                FontSize="15"
                                ReturnType="Next"/>
                        </Border>

                        <!-- DESCRIPCIÓN -->
                        <Label
                            Text="Descripción"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="#752B43"/>

                        <Border
                            BackgroundColor="#FFF4F6"
                            Stroke="#D7B4BC"
                            StrokeShape="RoundRectangle 12"
                            Padding="12,8">

                            <Editor
                                x:Name="txtDescripcion"
                                Placeholder="Describe el arreglo floral"
                                PlaceholderColor="#A89297"
                                TextColor="#68454D"
                                BackgroundColor="Transparent"
                                AutoSize="TextChanges"
                                MinimumHeightRequest="80"
                                FontSize="15"/>
                        </Border>

                        <!-- PRECIO Y STOCK -->
                        <Grid
                            ColumnDefinitions="*,*"
                            ColumnSpacing="12">

                            <!-- PRECIO -->
                            <VerticalStackLayout
                                Grid.Column="0"
                                Spacing="8">

                                <Label
                                    Text="Precio ($)"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    TextColor="#752B43"/>

                                <Border
                                    BackgroundColor="#FFF4F6"
                                    Stroke="#D7B4BC"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="10,0">

                                    <Entry
                                        x:Name="txtPrecio"
                                        Placeholder="0.00"
                                        Keyboard="Numeric"
                                        TextColor="#68454D"
                                        BackgroundColor="Transparent"
                                        HeightRequest="48"
                                        FontSize="15"/>
                                </Border>
                            </VerticalStackLayout>

                            <!-- STOCK -->
                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="8">

                                <Label
                                    Text="Stock"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    TextColor="#752B43"/>

                                <Border
                                    BackgroundColor="#FFF4F6"
                                    Stroke="#D7B4BC"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="10,0">

                                    <Entry
                                        x:Name="txtStock"
                                        Placeholder="0"
                                        Keyboard="Numeric"
                                        TextColor="#68454D"
                                        BackgroundColor="Transparent"
                                        HeightRequest="48"
                                        FontSize="15"/>
                                </Border>

                            </VerticalStackLayout>
                        </Grid>

                        <!-- CATEGORÍA -->
                        <Label
                            Text="Categoría"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="#752B43"
                            Margin="0,4,0,0"/>

                        <Border
                            BackgroundColor="#FFF4F6"
                            Stroke="#D7B4BC"
                            StrokeShape="RoundRectangle 12"
                            Padding="0">

                            <Picker
                                x:Name="pickerCategorias"
                                ItemDisplayBinding="{Binding nombre}"
                                TextColor="#68454D"
                                BackgroundColor="Transparent"
                                FontSize="15"
                                HeightRequest="50"
                                MinimumHeightRequest="50"
                                Margin="12,0"
                                VerticalOptions="Center"/>
                        </Border>

                        <!-- IMAGEN DEL PRODUCTO -->
                        <Label
                            Text="Imagen del producto"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="#752B43"
                            Margin="0,4,0,0"/>

                        <!-- CAMPO OCULTO:
                             CONSERVA LA LÓGICA ORIGINAL -->
                        <Entry
                            x:Name="txtImagenUrl"
                            IsVisible="False"/>

                        <!-- VISTA PREVIA -->
                        <Border
                            BackgroundColor="#FFF4F6"
                            Stroke="#E9DCE0"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 16"
                            HeightRequest="190"
                            Padding="10">

                            <Grid>

                                <VerticalStackLayout
                                    Spacing="8"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center">

                                    <mi:MauiIcon
                                        Icon="{mi:Material Icon=Image}"
                                        IconColor="#C68B93"
                                        IconSize="42"
                                        HorizontalOptions="Center"/>

                                    <Label
                                        Text="Vista previa de la fotografía"
                                        FontSize="12"
                                        TextColor="#A89297"
                                        HorizontalTextAlignment="Center"/>
                                </VerticalStackLayout>

                                <Image
                                    x:Name="imgPrevia"
                                    Aspect="AspectFit"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Fill"
                                    InputTransparent="True"/>

                            </Grid>
                        </Border>

                        <!-- SELECCIONAR IMAGEN -->
                        <Button
                            Text="Seleccionar fotografía"
                            Clicked="btnSeleccionarImagen"
                            BackgroundColor="#FFF6F7"
                            TextColor="#9B3E5C"
                            BorderColor="#D7B4BC"
                            BorderWidth="1"
                            CornerRadius="14"
                            HeightRequest="48"
                            FontSize="15"
                            FontAttributes="Bold"/>

                        <!-- NOMBRE DEL ARCHIVO, OCULTO -->
                        <Label
                            x:Name="lblRutaArchivo"
                            IsVisible="False"/>

                        <Label
                            Text="Selecciona una fotografía del arreglo."
                            FontSize="12"
                            TextColor="#9A858A"
                            HorizontalTextAlignment="Center"/>

                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- BOTÓN FIJO INFERIOR -->
        <Grid
            Grid.Row="1"
            Padding="18,10,18,16"
            BackgroundColor="#FFF9F6">

            <Button
                Text="Guardar arreglo"
                Clicked="Guardar_Clicked"
                BackgroundColor="#9B3E5C"
                TextColor="White"
                FontSize="16"
                FontAttributes="Bold"
                CornerRadius="16"
                HeightRequest="52"
                MaximumWidthRequest="540"/>

        </Grid>

    </Grid>

</ContentPage>
