<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    x:Class="addFloreriaG5.Views.vCatalogoArreglos"
    BackgroundColor="#FFF9F6"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">

    <Grid>

        <!-- =================================== -->
        <!-- FONDO FLORAL                        -->
        <!-- =================================== -->

        <Image
            Source="fondo_login_floral.png"
            Aspect="AspectFill"
            HorizontalOptions="Fill"
            VerticalOptions="Fill"
            InputTransparent="True"/>

        <!-- =================================== -->
        <!-- CONTENIDO PRINCIPAL                 -->
        <!-- =================================== -->

        <Grid
            Padding="16,20,16,16"
            RowDefinitions="Auto,Auto,Auto,*,Auto"
            RowSpacing="14">

            <!-- =================================== -->
            <!-- ENCABEZADO                          -->
            <!-- =================================== -->

            <Grid
                Grid.Row="0"
                ColumnDefinitions="45,*"
                ColumnSpacing="10"
                Margin="0,5,0,5">

                <!-- REGRESAR -->
                <Border
                    Grid.Column="0"
                    BackgroundColor="White"
                    Stroke="#E6D6DA"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    WidthRequest="44"
                    HeightRequest="44"
                    VerticalOptions="Center">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Tapped="Volver_Clicked"/>
                    </Border.GestureRecognizers>

                    <mi:MauiIcon
                        Icon="{mi:Material Icon=ArrowBack}"
                        IconColor="#7D273E"
                        IconSize="24"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"/>

                </Border>

                <!-- TITULOS -->
                <VerticalStackLayout
                    Grid.Column="1"
                    Spacing="5"
                    VerticalOptions="Center">

                    <Label
                        x:Name="lblTituloCatalogo"
                        Text="Catálogo de Arreglos"
                        FontSize="23"
                        FontAttributes="Bold"
                        TextColor="#752B43"
                        HorizontalTextAlignment="Center"/>

                </VerticalStackLayout>

            </Grid>

            <!-- =================================== -->
            <!-- BUSCADOR                            -->
            <!-- =================================== -->

            <Border
                Grid.Row="1"
                BackgroundColor="White"
                Stroke="#E6D6DA"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 18"
                Padding="12,2">

                <Grid
                    ColumnDefinitions="30,*"
                    ColumnSpacing="8">

                    <mi:MauiIcon
                        Grid.Column="0"
                        Icon="{mi:Material Icon=Search}"
                        IconColor="#9B3E5C"
                        IconSize="24"
                        VerticalOptions="Center"
                        HorizontalOptions="Center"/>

                    <Entry
                        Grid.Column="1"
                        x:Name="txtBuscar"
                        Placeholder="Buscar arreglo..."
                        PlaceholderColor="#A89297"
                        TextColor="#68454D"
                        BackgroundColor="Transparent"
                        FontSize="14"
                        HeightRequest="48"
                        ClearButtonVisibility="WhileEditing"
                        TextChanged="txtBuscar_TextChanged"/>

                </Grid>

            </Border>

            <!-- =================================== -->
            <!-- FILTROS                             -->
            <!-- =================================== -->

            <Grid
                x:Name="panelFiltros"
                Grid.Row="2"
                ColumnDefinitions="*,*,*"
                ColumnSpacing="8">

                <!-- TODOS -->
                <Button
                    Grid.Column="0"
                    x:Name="btnTodos"
                    Text="Todos"
                    Clicked="btnTodos_Clicked"
                    BackgroundColor="#9B3E5C"
                    TextColor="White"
                    BorderColor="#9B3E5C"
                    BorderWidth="1"
                    FontSize="12"
                    FontAttributes="Bold"
                    CornerRadius="15"
                    HeightRequest="43"
                    Padding="4,0"/>

                <!-- ACTIVOS -->
                <Button
                    Grid.Column="1"
                    x:Name="btnActivos"
                    Text="Activos"
                    Clicked="btnActivos_Clicked"
                    BackgroundColor="White"
                    TextColor="#7D273E"
                    BorderColor="#CDB6BD"
                    BorderWidth="1"
                    FontSize="12"
                    FontAttributes="Bold"
                    CornerRadius="15"
                    HeightRequest="43"
                    Padding="4,0"/>

                <!-- INACTIVOS -->
                <Button
                    Grid.Column="2"
                    x:Name="btnInactivos"
                    Text="Inactivos"
                    Clicked="btnInactivos_Clicked"
                    BackgroundColor="White"
                    TextColor="#7D273E"
                    BorderColor="#CDB6BD"
                    BorderWidth="1"
                    FontSize="12"
                    FontAttributes="Bold"
                    CornerRadius="15"
                    HeightRequest="43"
                    Padding="4,0"/>

            </Grid>

            <!-- =================================== -->
            <!-- LISTA DE ARREGLOS                   -->
            <!-- =================================== -->

            <CollectionView
                Grid.Row="3"
                x:Name="cvArreglos"
                SelectionMode="None"
                VerticalScrollBarVisibility="Default"
                Margin="0,2,0,0">

                <!-- LISTA VACIA -->
                <CollectionView.EmptyView>

                    <VerticalStackLayout
                        Spacing="12"
                        Padding="15,45"
                        HorizontalOptions="Center">

                        <mi:MauiIcon
                            Icon="{mi:Material Icon=LocalFlorist}"
                            IconColor="#C68B93"
                            IconSize="48"
                            HorizontalOptions="Center"/>

                        <Label
                            Text="No se encontraron arreglos"
                            FontSize="17"
                            FontAttributes="Bold"
                            TextColor="#752B43"
                            HorizontalTextAlignment="Center"/>

                        <Label
                            Text="Intenta con otra búsqueda o filtro."
                            FontSize="13"
                            TextColor="#8A7A78"
                            HorizontalTextAlignment="Center"/>

                    </VerticalStackLayout>

                </CollectionView.EmptyView>

                <!-- TARJETAS -->
                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <Border
                            BackgroundColor="White"
                            Stroke="#E9DCE0"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 22"
                            Padding="13"
                            Margin="0,0,0,13">

                            <Border.Shadow>
                                <Shadow
                                    Brush="#BCA5AA"
                                    Offset="0,3"
                                    Radius="7"
                                    Opacity="0.10"/>
                            </Border.Shadow>

                            <VerticalStackLayout Spacing="12">

                                <!-- INFORMACION SUPERIOR -->
                                <Grid
                                    ColumnDefinitions="94,*"
                                    ColumnSpacing="13">

                                    <!-- IMAGEN -->
                                    <Border
                                        Grid.Column="0"
                                        BackgroundColor="#F8F0F2"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 16"
                                        HeightRequest="100"
                                        WidthRequest="94"
                                        VerticalOptions="Start">

                                        <Image
                                            Source="{Binding imagen}"
                                            Aspect="AspectFill"
                                            HeightRequest="100"
                                            WidthRequest="94"/>

                                    </Border>

                                    <!-- DATOS -->
                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        Spacing="5">

                                        <!-- NOMBRE -->
                                        <Label
                                            Text="{Binding nombre}"
                                            FontSize="17"
                                            FontAttributes="Bold"
                                            TextColor="#752B43"
                                            MaxLines="2"
                                            LineBreakMode="TailTruncation"/>

                                        <!-- DESCRIPCION -->
                                        <Label
                                            Text="{Binding descripcion}"
                                            FontSize="12"
                                            TextColor="#8A7A78"
                                            MaxLines="2"
                                            LineBreakMode="TailTruncation"/>

                                        <!-- PRECIO -->
                                        <Label
                                            Text="{Binding precio,
                                                StringFormat='${0:F2}'}"
                                            FontSize="18"
                                            FontAttributes="Bold"
                                            TextColor="#63754D"/>

                                        <!-- STOCK -->
                                        <Label
                                            Text="{Binding stock,
                                                StringFormat='Stock: {0} unidades'}"
                                            FontSize="12"
                                            TextColor="#82776D"/>

                                        <!-- ESTADO -->
                                        <Border
                                            BackgroundColor="#EEF4E9"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 12"
                                            Padding="9,4"
                                            HorizontalOptions="Start">

                                            <!-- TRIGGER CORREGIDO -->
                                            <Border.Triggers>

                                                <DataTrigger
                                                    TargetType="Border"
                                                    Binding="{Binding estado}"
                                                    Value="False">

                                                    <Setter
                                                        Property="BackgroundColor"
                                                        Value="#F7E9EC"/>

                                                </DataTrigger>

                                            </Border.Triggers>

                                            <Label
                                                Text="Activo"
                                                FontSize="11"
                                                FontAttributes="Bold"
                                                TextColor="#698356">

                                                <!-- TRIGGER DENTRO DEL LABEL -->
                                                <Label.Triggers>

                                                    <DataTrigger
                                                        TargetType="Label"
                                                        Binding="{Binding estado}"
                                                        Value="False">

                                                        <Setter
                                                            Property="Text"
                                                            Value="Inactivo"/>

                                                        <Setter
                                                            Property="TextColor"
                                                            Value="#A04B64"/>

                                                    </DataTrigger>

                                                </Label.Triggers>

                                            </Label>

                                        </Border>

                                    </VerticalStackLayout>

                                </Grid>

                                <!-- SEPARADOR -->
                                <BoxView
                                    HeightRequest="1"
                                    Color="#F0E5E8"/>

                                <!-- =================================== -->
                                <!-- BOTONES DE ACCION                   -->
                                <!-- =================================== -->

                                <!-- =================================== -->
                                <!-- ACCIONES SEGÚN EL ROL               -->
                                <!-- =================================== -->

                                <!-- BOTONES DEL ADMINISTRADOR -->
                                <Grid
                                    ColumnDefinitions="*,*,*"
                                    ColumnSpacing="8"
                                    IsVisible="{Binding MostrarAccionesAdmin}">

                                    <!-- DETALLES -->
                                    <Button
                                    Grid.Column="0"
                                    Text="Detalles"
                                    Clicked="btnDetalles"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="#F2F4EA"
                                    TextColor="#63754D"
                                    BorderColor="#B7C3A4"
                                    BorderWidth="1"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    CornerRadius="11"
                                    HeightRequest="45"/>

                                    <!-- EDITAR -->
                                    <Button
                                    Grid.Column="1"
                                    Text="Editar"
                                    Clicked="btnEditar"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="#F9ECE8"
                                    TextColor="#A56F58"
                                    BorderColor="#E2C1B4"
                                    BorderWidth="1"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    CornerRadius="11"
                                    HeightRequest="45"/>

                                    <!-- ACTIVAR / DESACTIVAR -->
                                    <Button
                                        Grid.Column="2"
                                        Text="Desactivar"
                                        Clicked="btnCambiarEstadoArreglo_Clicked"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="#9B3E5C"
                                        TextColor="White"
                                        FontSize="11"
                                        FontAttributes="Bold"
                                        CornerRadius="11"
                                        HeightRequest="45">

                                        <Button.Triggers>
                                            <DataTrigger
                                                TargetType="Button"
                                                Binding="{Binding estado}"
                                                Value="False">

                                                <Setter
                                                Property="Text"
                                                Value="Activar"/>

                                                <Setter
                                                Property="BackgroundColor"
                                                Value="#8B9779"/>
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>

                                </Grid>

                                <!-- BOTONES DEL CLIENTE -->
                                <Grid
                                    ColumnDefinitions="*,*"
                                    ColumnSpacing="10"
                                    IsVisible="{Binding MostrarAccionesCliente}">

                                    <!-- DETALLES -->
                                    <!--<Button
                                    Grid.Column="0"
                                    Text="Detalles"
                                    Clicked="Button_Clicked_2"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="#F2F4EA"
                                    TextColor="#63754D"
                                    BorderColor="#B7C3A4"
                                    BorderWidth="1"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    CornerRadius="11"
                                    HeightRequest="45"/>-->

                                    <!-- AGREGAR AL CARRITO -->
                                    <Button
                                    Grid.Column="1"
                                    Text="Agregar al carrito"
                                    Clicked="AgregarCarrito_Clicked"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="#9B3E5C"
                                    TextColor="White"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    CornerRadius="11"
                                    HeightRequest="45"/>

                                </Grid>


                            </VerticalStackLayout>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

            <!-- =================================== -->
            <!-- AGREGAR NUEVO ARREGLO               -->
            <!-- =================================== -->

            <Button
                Grid.Row="4"
                x:Name="btnNuevoArreglo"
                Text="+ Agregar nuevo arreglo"
                Clicked="btnNuevoArreglo_Clicked"
                BackgroundColor="#8B9779"
                TextColor="White"
                FontSize="16"
                FontAttributes="Bold"
                CornerRadius="18"
                HeightRequest="54"
                Margin="0,5,0,0"/>


            <!-- CARRITO: SOLO CLIENTE -->
            <Button
                Grid.Row="4"
                x:Name="btnVerCarrito"
                Text="Ver mi carrito"
                IsVisible="False"
                Clicked="VerCarrito_Clicked"
                BackgroundColor="#9B3E5C"
                TextColor="White"
                FontSize="15"
                FontAttributes="Bold"
                CornerRadius="18"
                HeightRequest="54"
                Margin="0,5,0,0"/>

        </Grid>


            <!-- VENTANA PERSONALIZADA DE DETALLES -->
        <Grid
        x:Name="panelDetalles"
        IsVisible="False"
        BackgroundColor="#99000000"
        Padding="20">

            <Border
            BackgroundColor="#FFFFFF"
            Stroke="#EBD7DC"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 26"
            Padding="22"
            MaximumWidthRequest="380"
            HorizontalOptions="Fill"
            VerticalOptions="Center">

                <Border.Shadow>
                    <Shadow
                    Brush="#7A4D5A"
                    Offset="0,5"
                    Radius="16"
                    Opacity="0.20"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="18">

                    <!-- ENCABEZADO -->
                    <Grid ColumnDefinitions="*,Auto">

                        <Label
                        Text="Detalles del arreglo"
                        FontSize="21"
                        FontAttributes="Bold"
                        TextColor="#752B43"
                        VerticalTextAlignment="Center"/>

                        <Button
                        Grid.Column="1"
                        Text="✕"
                        FontSize="18"
                        TextColor="#752B43"
                        BackgroundColor="Transparent"
                        Clicked="CerrarDetalles_Clicked"
                        WidthRequest="44"
                        HeightRequest="44"/>
                    </Grid>

                    <BoxView
                    HeightRequest="1"
                    Color="#EBD7DC"/>

                    <!-- INFORMACIÓN DEL ARREGLO -->
                    <Grid
                    ColumnDefinitions="95,*"
                    ColumnSpacing="14">

                        <Border
                        BackgroundColor="#F8E8ED"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 15"
                        WidthRequest="95"
                        HeightRequest="100">

                            <Image
                            x:Name="imgDetalle"
                            Aspect="AspectFit"/>
                        </Border>

                        <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="7"
                        VerticalOptions="Center">

                            <Label
                            x:Name="lblDetalleNombre"
                            FontSize="19"
                            FontAttributes="Bold"
                            TextColor="#752B43"
                            LineBreakMode="WordWrap"/>

                            <Label
                            x:Name="lblDetalleDescripcion"
                            FontSize="13"
                            TextColor="#867A78"
                            LineBreakMode="WordWrap"/>

                            <Label
                            x:Name="lblDetalleEstado"
                            FontSize="13"
                            FontAttributes="Bold"
                            TextColor="#698356"/>

                        </VerticalStackLayout>
                    </Grid>

                    <!-- PRECIO Y STOCK -->
                    <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="10">

                        <Border
                        BackgroundColor="#F7F3EB"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 15"
                        Padding="14">

                            <VerticalStackLayout Spacing="6">

                                <Label
                                Text="Precio"
                                FontSize="12"
                                TextColor="#857B73"/>

                                <Label
                                x:Name="lblDetallePrecio"
                                FontSize="21"
                                FontAttributes="Bold"
                                TextColor="#63754D"/>

                            </VerticalStackLayout>
                        </Border>

                        <Border
                        Grid.Column="1"
                        BackgroundColor="#FFF1F4"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 15"
                        Padding="14">

                            <VerticalStackLayout Spacing="6">

                                <Label
                                Text="Stock disponible"
                                FontSize="12"
                                TextColor="#857B73"/>

                                <Label
                                x:Name="lblDetalleStock"
                                FontSize="19"
                                FontAttributes="Bold"
                                TextColor="#752B43"/>

                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- CERRAR -->
                    <Button
                    Text="Cerrar detalles"
                    Clicked="CerrarDetalles_Clicked"
                    BackgroundColor="#9B3E5C"
                    TextColor="White"
                    FontSize="15"
                    FontAttributes="Bold"
                    CornerRadius="15"
                    HeightRequest="48"/>

                </VerticalStackLayout>

            </Border>
        </Grid>

    </Grid>


</ContentPage>
