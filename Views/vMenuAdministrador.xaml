<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="addFloreriaG5.Views.vMenuAdministrador"
             Title="Panel de Administración"
             BackgroundColor="#F9F6F0">

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="16" VerticalOptions="Center">
            
            <Label
                x:Name="lblUsuario"
                FontSize="18"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                TextColor="#707A5E"/>

        <!-- Encabezado -->
        <Label x:Name="lblTituloAdmin" 
                   Text="Panel de Control" 
                   FontSize="26" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center" 
                   TextColor="#4A453F"/>

            <Label Text="Gestión general de florería, pedidos y rutas" 
                   FontSize="13" 
                   TextColor="#8C857B" 
                   HorizontalOptions="Center" 
                   Margin="0,0,0,10"/>

            <!-- Botones de Acceso -->
            <Frame BackgroundColor="White" 
                   BorderColor="#E0DCD5" 
                   CornerRadius="16" 
                   Padding="15" 
                   HasShadow="True">

                <Grid RowDefinitions="Auto, Auto, Auto" 
                      ColumnDefinitions="*, *" 
                      RowSpacing="10" 
                      ColumnSpacing="10">
                    
            
        <Button Text=" Ver y Gestionar Catálogo (Arreglos)" 
                    Clicked="Button_Clicked" 
BackgroundColor="#707A5E" 
                            TextColor="White" 
                            FontAttributes="Bold"
                            FontSize="13"
                            CornerRadius="12" 
                            HeightRequest="60"
                            Grid.Row="0" Grid.Column="0"/>

        <Button Text=" Ver Pedidos y Negociar (WhatsApp)" 
                    Clicked="Button_Clicked_1" 
BackgroundColor="#5A634B"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="13"
                            CornerRadius="12"
                            HeightRequest="60"
                            Grid.Row="0" Grid.Column="1"/>

        <Button Text=" Control de Entregas" 
                    Clicked="Button_Clicked_2" 
BackgroundColor="#D39E82"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="13"
                            CornerRadius="12"
                            HeightRequest="60"
                            Grid.Row="1" Grid.Column="0"/>

        <Button Text=" Gestionar Usuarios y Roles" 
                    Clicked="Button_Clicked_3" 
BackgroundColor="#8C857B" 
                            TextColor="White" 
                            FontAttributes="Bold"
                            FontSize="13"
                            CornerRadius="12" 
                            HeightRequest="60"
                            Grid.Row="1" Grid.Column="1"/>

            <!-- Botón para ver Productos Inactivos -->
            <Button Text=" Ver Productos Inactivos"
BackgroundColor="#C28F74"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="13"
                            CornerRadius="12"
                            HeightRequest="50"
                            Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
        Clicked="Button_Clicked_5" />
                </Grid>
            </Frame>


            <!-- Botón de Cerrar Sesión -->
        <Button Text="Cerrar Sesión" 
                    Clicked="Button_Clicked_4" 
                    BackgroundColor="Transparent" 
                    TextColor="#C0392B" 
                    BorderColor="#C0392B"
                    BorderWidth="1.5"
                    FontAttributes="Bold"
                    CornerRadius="12" 
                    Margin="0,15,0,0" 
                    HeightRequest="45"/>

    </VerticalStackLayout>
    </ScrollView>
</ContentPage>