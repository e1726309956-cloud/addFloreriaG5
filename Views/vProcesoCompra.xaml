<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    x:Class="addFloreriaG5.Views.vProcesoCompra"
    BackgroundColor="#FFF9F6"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">

    <Grid>

        <!-- FONDO FLORAL -->
        <Image
            Source="fondo_login_floral.png"
            Aspect="AspectFill"
            HorizontalOptions="Fill"
            VerticalOptions="Fill"
            InputTransparent="True"/>

        <!-- CONTENIDO -->
        <ScrollView
            VerticalScrollBarVisibility="Default">

            <VerticalStackLayout
                Padding="18,22,18,35"
                Spacing="18"
                MaximumWidthRequest="580"
                HorizontalOptions="Center">

                <!-- ENCABEZADO -->
                <Grid
                    ColumnDefinitions="45,*,45"
                    ColumnSpacing="10">

                    <Border
                        Grid.Column="0"
                        BackgroundColor="White"
                        Stroke="#E6D6DA"
                        StrokeShape="RoundRectangle 14"
                        WidthRequest="44"
                        HeightRequest="44">

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Tapped="Volver_Tapped"/>
                        </Border.GestureRecognizers>

                        <mi:MauiIcon
                            Icon="{mi:Material Icon=ArrowBack}"
                            IconColor="#752B43"
                            IconSize="24"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"/>
                    </Border>

                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="4">

                        <Label
                            Text="Mi carrito"
                            FontSize="25"
                            FontAttributes="Bold"
                            TextColor="#752B43"
                            HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>

                    <mi:MauiIcon
                        Grid.Column="2"
                        Icon="{mi:Material Icon=ShoppingCart}"
                        IconColor="#9B3E5C"
                        IconSize="27"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"/>

                </Grid>

                <!-- SECCIÓN DE PRODUCTOS -->
                <VerticalStackLayout Spacing="12">

                    <Label
                        Text="Tus arreglos seleccionados"
                        FontSize="17"
                        FontAttributes="Bold"
                        TextColor="#752B43"/>

                    <!-- LISTADO DEL CARRITO -->
                    <CollectionView
                        x:Name="cvCarrito"
                        HeightRequest="100"
                        SelectionMode="None"
                        VerticalScrollBarVisibility="Never">

                        <CollectionView.EmptyView>
                            <Label
                                Text="Tu carrito está vacío."
                                TextColor="#8A7A78"
                                HorizontalTextAlignment="Center"
                                Margin="0,25"/>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>

                                <Border
                                    BackgroundColor="White"
                                    Stroke="#EBDCE0"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 18"
                                    Padding="12"
                                    Margin="0,0,0,10">

                                    <Grid
                                        ColumnDefinitions="75,*"
                                        ColumnSpacing="12">

                                        <!-- FOTO DEL PRODUCTO -->
                                        <Border
                                            Grid.Column="0"
                                            WidthRequest="75"
                                            HeightRequest="85"
                                            BackgroundColor="#F9E9EE"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 12"
                                            VerticalOptions="Center">

                                            <Image
                                                Source="{Binding Arreglo.imagen}"
                                                Aspect="AspectFill"/>
                                        </Border>

                                        <!-- INFORMACIÓN -->
                                        <VerticalStackLayout
                                            Grid.Column="1"
                                            Spacing="6"
                                            VerticalOptions="Center">

                                            <Label
                                                Text="{Binding Arreglo.nombre}"
                                                FontSize="15"
                                                FontAttributes="Bold"
                                                TextColor="#752B43"
                                                MaxLines="2"/>

                                            <Label
                                                Text="{Binding Arreglo.precio, StringFormat='${0:F2} por unidad'}"
                                                FontSize="12"
                                                TextColor="#8A7A78"/>

                                            <Grid
                                                ColumnDefinitions="Auto,75,*"
                                                ColumnSpacing="8">

                                                <Label
                                                    Grid.Column="0"
                                                    Text="Cantidad"
                                                    FontSize="12"
                                                    TextColor="#8A7A78"
                                                    VerticalTextAlignment="Center"/>

                                                <Border
                                                    Grid.Column="1"
                                                    BackgroundColor="#FFF4F6"
                                                    Stroke="#EBDCE0"
                                                    StrokeShape="RoundRectangle 10"
                                                    Padding="5,0">

                                                    <Entry
                                                        Text="{Binding Cantidad, Mode=TwoWay}"
                                                        Keyboard="Numeric"
                                                        TextColor="#752B43"
                                                        FontSize="13"
                                                        BackgroundColor="Transparent"
                                                        HorizontalTextAlignment="Center"
                                                        HeightRequest="40"
                                                        TextChanged="OnCantidadEntryChanged"/>
                                                </Border>

                                                <Label
                                                    Grid.Column="2"
                                                    Text="{Binding Subtotal, StringFormat='${0:F2}'}"
                                                    FontSize="15"
                                                    FontAttributes="Bold"
                                                    TextColor="#63754D"
                                                    HorizontalTextAlignment="End"
                                                    VerticalTextAlignment="Center"/>
                                            </Grid>

                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>

                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- SEGUIR COMPRANDO -->
                    <Button
                        Text="Seguir comprando"
                        Clicked="OnSeguirComprandoClicked"
                        BackgroundColor="#FFF9F6"
                        TextColor="#9B3E5C"
                        BorderColor="#D9B7C1"
                        BorderWidth="1"
                        FontAttributes="Bold"
                        FontSize="14"
                        CornerRadius="13"
                        HeightRequest="46"/>

                </VerticalStackLayout>

                <!-- RESUMEN -->
                <Border
                    BackgroundColor="White"
                    Stroke="#EBDCE0"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 20"
                    Padding="18">

                    <VerticalStackLayout Spacing="13">

                        <Label
                            Text="Resumen del pedido"
                            FontSize="17"
                            FontAttributes="Bold"
                            TextColor="#752B43"/>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label
                                Text="Subtotal"
                                TextColor="#8A7A78"
                                FontSize="14"/>

                            <Label
                                Grid.Column="1"
                                x:Name="lblSubtotal"
                                Text="$0,00"
                                FontAttributes="Bold"
                                TextColor="#752B43"/>
                        </Grid>

                        <BoxView
                            HeightRequest="1"
                            Color="#EBDCE0"/>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label
                                Text="TOTAL A PAGAR"
                                FontAttributes="Bold"
                                FontSize="15"
                                TextColor="#752B43"
                                VerticalTextAlignment="Center"/>

                            <Label
                                Grid.Column="1"
                                x:Name="lblTotal"
                                Text="$0,00"
                                FontAttributes="Bold"
                                FontSize="21"
                                TextColor="#63754D"/>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- DATOS DE ENTREGA -->
                <Border
                    BackgroundColor="White"
                    Stroke="#EBDCE0"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 20"
                    Padding="18">

                    <VerticalStackLayout Spacing="13">

                        <HorizontalStackLayout Spacing="9">
                            <mi:MauiIcon
                                Icon="{mi:Material Icon=LocalShipping}"
                                IconSize="24"
                                IconColor="#9B3E5C"/>

                            <Label
                                Text="Información de entrega"
                                FontSize="17"
                                FontAttributes="Bold"
                                TextColor="#752B43"
                                VerticalTextAlignment="Center"/>
                        </HorizontalStackLayout>

                        <Label
                            Text="Completa los datos de quien recibirá el arreglo."
                            FontSize="12"
                            TextColor="#8A7A78"/>

                        <!-- NOMBRE -->
                        <Label
                            Text="Nombre completo"
                            FontAttributes="Bold"
                            FontSize="13"
                            TextColor="#752B43"/>

                        <Border
                            BackgroundColor="#FFF4F6"
                            Stroke="#D7B4BC"
                            StrokeShape="RoundRectangle 12"
                            Padding="12,0">

                            <Entry
                                x:Name="txtNombreCliente"
                                Placeholder="Nombre de quien recibe"
                                PlaceholderColor="#A89297"
                                TextColor="#68454D"
                                BackgroundColor="Transparent"
                                HeightRequest="48"
                                ReturnType="Next"/>
                        </Border>

                        <!-- TELÉFONO -->
                        <Label
                            Text="Teléfono de contacto"
                            FontAttributes="Bold"
                            FontSize="13"
                            TextColor="#752B43"/>

                        <Border
                            BackgroundColor="#FFF4F6"
                            Stroke="#D7B4BC"
                            StrokeShape="RoundRectangle 12"
                            Padding="12,0">

                            <Entry
                                x:Name="txtTelefono"
                                Placeholder="Número de teléfono"
                                Keyboard="Telephone"
                                PlaceholderColor="#A89297"
                                TextColor="#68454D"
                                BackgroundColor="Transparent"
                                HeightRequest="48"
                                ReturnType="Next"/>
                        </Border>

                        <!-- DIRECCIÓN -->
                        <Label
                            Text="Dirección de entrega"
                            FontAttributes="Bold"
                            FontSize="13"
                            TextColor="#752B43"/>

                        <Border
                            BackgroundColor="#FFF4F6"
                            Stroke="#D7B4BC"
                            StrokeShape="RoundRectangle 12"
                            Padding="12,6">

                            <Editor
                                x:Name="txtDireccion"
                                Placeholder="Calle, número y referencia"
                                PlaceholderColor="#A89297"
                                TextColor="#68454D"
                                BackgroundColor="Transparent"
                                AutoSize="TextChanges"
                                MinimumHeightRequest="85"/>
                        </Border>


                        <!-- FECHA Y HORA SOLICITADA DE ENTREGA -->
                        <Label Text="Fecha y hora de entrega"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#752B43"
                           Margin="0,6,0,0"/>

                        <Grid ColumnDefinitions="*,*"
                            ColumnSpacing="10">

                            <!-- FECHA -->
                            <VerticalStackLayout Grid.Column="0" Spacing="7">
                                <Label Text="Fecha"
                                   FontSize="12"
                                   TextColor="#8A7A78"/>

                                <Border BackgroundColor="#FFF4F6"
                                    Stroke="#D7B4BC"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="8,0">

                                    <DatePicker x:Name="dpFechaEntrega"
                                    Format="dd/MM/yyyy"
                                    TextColor="#752B43"
                                    BackgroundColor="Transparent"
                                    HeightRequest="50"
                                    HorizontalOptions="Fill"/>
                                </Border>
                            </VerticalStackLayout>

                            <!-- HORA -->
                            <VerticalStackLayout Grid.Column="1" Spacing="7">
                                <Label Text="Hora"
                                   FontSize="12"
                                   TextColor="#8A7A78"/>

                                <Border BackgroundColor="#FFF4F6"
                                    Stroke="#D7B4BC"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="8,0">

                                    <TimePicker x:Name="tpHoraEntrega"
                                    Format="HH:mm"
                                    TextColor="#752B43"
                                    BackgroundColor="Transparent"
                                    HeightRequest="50"
                                    HorizontalOptions="Fill"/>
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <Label
                                    Text="Selecciona cuándo necesitas recibir tu arreglo. La disponibilidad será confirmada por la florería."
                                    FontSize="11"
                                    TextColor="#8A7A78"
                                    LineBreakMode="WordWrap"/>

                    </VerticalStackLayout>
                </Border>

                <!-- CONFIRMACIÓN -->
                <Button
                    x:Name="btnConfirmarPedido"
                    Text="Confirmar pedido"
                    Clicked="btnConfirmarPedidos"
                    IsEnabled="True"
                    BackgroundColor="#9B3E5C"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="16"
                    CornerRadius="16"
                    HeightRequest="54"/>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
